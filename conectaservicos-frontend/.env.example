# URL base da API do backend ConectaServiços (sem barra no final, e SEM /api —
# o código já acrescenta /api automaticamente em src/api/api.ts).
#
# Local: aponte para o backend rodando na sua máquina.
VITE_API_URL=http://localhost:4000
#
# Produção (Vercel): esta variável NÃO é lida deste arquivo — ela precisa ser
# cadastrada em Project Settings > Environment Variables no painel da Vercel,
# apontando para a URL pública do backend no Render, ex.:
# VITE_API_URL=https://conectaservicos-backend.onrender.com
# Sem isso, o build de produção fica sem a variável e as chamadas à API
# quebram silenciosamente (ver comentário em src/api/api.ts).
