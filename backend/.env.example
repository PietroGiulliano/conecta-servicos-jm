# ── Banco de dados ─────────────────────────────────────────────
# Valores abaixo já batem com o docker-compose.yml da raiz do projeto
# (docker compose up -d sobe um Postgres local com essas credenciais).
DATABASE_URL="postgresql://conectaservicos:conectaservicos@localhost:5432/conectaservicos?schema=public"

# ── Aplicação ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Uma ou mais origens permitidas pelo CORS, separadas por vírgula e sem barra
# no final. Em produção, use o(s) domínio(s) da Vercel, ex.:
# FRONTEND_URL="https://conectaservicos-frontend-4ezi.vercel.app"
FRONTEND_URL="http://localhost:5173"
PUBLIC_API_URL="http://localhost:4000"

# ── Autenticação ───────────────────────────────────────────────
# Gere valores aleatórios fortes, ex: `openssl rand -hex 64`
JWT_SECRET="troque_por_um_segredo_forte_e_aleatorio"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="troque_por_outro_segredo_forte_e_aleatorio"
JWT_REFRESH_EXPIRES_IN="30d"

# ── Comissão padrão (pode ser sobrescrita via painel admin / platform_settings) ─
DEFAULT_COMMISSION_PERCENT=10

# ── Gateway de pagamento ──────────────────────────────────────
# Escolha qual provider está ativo: MERCADO_PAGO ou STRIPE
ACTIVE_PAYMENT_PROVIDER="MERCADO_PAGO"

# Mercado Pago (obter em https://www.mercadopago.com.br/developers — use as credenciais de TESTE/sandbox)
MERCADOPAGO_ACCESS_TOKEN="TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MERCADOPAGO_PUBLIC_KEY="TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
MERCADOPAGO_WEBHOOK_SECRET="troque_pelo_segredo_de_assinatura_do_webhook"
MERCADOPAGO_CLIENT_ID="SEU_APP_ID"
MERCADOPAGO_CLIENT_SECRET="SUA_CLIENT_SECRET"
MERCADOPAGO_OAUTH_REDIRECT_URI="http://localhost:4000/api/providers/payment/mercadopago/callback"
MERCADOPAGO_TEST_TOKEN="true"

# Stripe Connect (obter em https://dashboard.stripe.com/test/apikeys — use chaves de TESTE)
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ── Upload de arquivos (documentos de prestadores, fotos) ─────
# Em produção, trocar por um bucket S3/Cloudflare R2. Em dev, salva localmente em /uploads
UPLOAD_DIR="./uploads"

# ── Envio de email transacional (redefinição de senha) ─────────
# Sem estas variáveis, o link de redefinição só é impresso no console (modo dev).
# Qualquer provedor SMTP funciona: SES, SendGrid, Mailgun, Postmark, Gmail SMTP, etc.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ConectaServiços <no-reply@conectaservicos.com>"
