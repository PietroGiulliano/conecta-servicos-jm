// ConectaServiços — schema relacional completo
// Rode `npx prisma migrate dev` após configurar DATABASE_URL no .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENTE
  EMPRESA
  PRESTADOR
  ADMIN
}

enum UserStatus {
  ATIVO
  BLOQUEADO
  PENDENTE_VERIFICACAO
}

enum ProviderApprovalStatus {
  PENDENTE
  APROVADO
  REPROVADO
}

enum ServiceRequestStatus {
  SOLICITADO
  PROPOSTAS_RECEBIDAS
  PROPOSTA_ACEITA
  AGUARDANDO_PAGAMENTO
  PAGAMENTO_APROVADO
  EM_ANDAMENTO
  CONCLUIDO
  CANCELADO
  ESTORNADO
}

enum ProposalStatus {
  ENVIADA
  ACEITA
  RECUSADA
  EXPIRADA
}

enum PaymentStatus {
  PENDENTE
  APROVADO
  RECUSADO
  CANCELADO
  ESTORNADO
  CHARGEBACK
}

enum PaymentMethod {
  PIX
  CARTAO_CREDITO
  CARTAO_DEBITO
  OUTRO
}

enum PaymentGateway {
  MERCADO_PAGO
  STRIPE
}

enum PayoutStatus {
  PENDENTE
  PROCESSANDO
  PAGO
  FALHOU
}

enum NotificationType {
  NOVA_SOLICITACAO
  NOVA_PROPOSTA
  PROPOSTA_ACEITA
  PAGAMENTO_APROVADO
  PAGAMENTO_PENDENTE
  SERVICO_INICIADO
  SERVICO_CONCLUIDO
  NOVA_MENSAGEM
  NOVA_AVALIACAO
  REPASSE_REALIZADO
}

enum DisputeStatus {
  ABERTA
  EM_ANALISE
  RESOLVIDA
  REJEITADA
}

// ─────────────────────────────────────────────────────────────────
// USUÁRIOS
// ─────────────────────────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  phone         String?
  passwordHash  String
  role          UserRole
  status        UserStatus @default(ATIVO)
  emailVerifiedAt DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  customerProfile CustomerProfile?
  companyProfile  CompanyProfile?
  providerProfile ProviderProfile?
  addresses       Address[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  refreshTokens   RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

model CustomerProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  city      String?
  favorites Favorite[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests ServiceRequest[]
  reviewsGiven    Review[]          @relation("ReviewsByCustomer")
  orders          Order[]

  @@map("customer_profiles")
}

model CompanyProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  legalName   String
  tradeName   String?
  documentNumber String // CNPJ
  city        String
  state       String
  industry    String?
  website     String?
  description String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city])
  @@map("company_profiles")
}

model ProviderProfile {
  id                 String                 @id @default(uuid())
  userId             String                 @unique
  professionalName   String
  documentNumber     String? // CPF/CNPJ
  photoUrl           String?
  bio                String?
  categoryId         String?
  specialties         String[]
  citiesServed        String[]
  serviceRadiusKm     Int?
  startingPrice       Decimal                @db.Decimal(10, 2)
  availability        Json? // estrutura livre de disponibilidade semanal
  approvalStatus       ProviderApprovalStatus @default(PENDENTE)
  ratingAverage        Decimal                @default(0) @db.Decimal(3, 2)
  ratingCount          Int                    @default(0)
  paymentAccountId     String? // id da conta no gateway (Mercado Pago/Stripe Connect)
  mpAccessTokenEncrypted String?
  mpRefreshTokenEncrypted String?
  mpTokenExpiresAt      DateTime?
  mpCollectorId         String?
  mpPublicKey           String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category?          @relation(fields: [categoryId], references: [id])
  documents       ProviderDocument[]
  serviceRequests ServiceRequest[]   @relation("RequestsForProvider")
  proposals       Proposal[]
  orders          Order[]
  reviewsReceived Review[]           @relation("ReviewsForProvider")
  wallet          ProviderWallet?
  galleryItems    GalleryItem[]
  favoritedBy     Favorite[]
  paymentOAuthStates PaymentOAuthState[]

  @@index([categoryId])
  @@map("provider_profiles")
}

model ProviderDocument {
  id         String    @id @default(uuid())
  providerId String
  type       String
  fileUrl    String
  verified   Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("provider_documents")
}

model GalleryItem {
  id         String   @id @default(uuid())
  providerId String
  imageUrl   String
  caption    String?
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("gallery_items")
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  label      String?
  street     String
  number     String?
  complement String?
  district   String?
  city       String
  state      String
  zipCode    String
  latitude   Decimal? @db.Decimal(9, 6)
  longitude  Decimal? @db.Decimal(9, 6)
  createdAt  DateTime @default(now())

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceRequests  ServiceRequest[]

  @@map("addresses")
}

model Favorite {
  id         String   @id @default(uuid())
  customerId String
  providerId String
  createdAt  DateTime @default(now())

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([customerId, providerId])
  @@map("favorites")
}

// ─────────────────────────────────────────────────────────────────
// CATEGORIAS E SERVIÇOS
// ─────────────────────────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  iconKey     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  providers ProviderProfile[]
  requests  ServiceRequest[]

  @@map("categories")
}

model ServiceRequest {
  id              String                @id @default(uuid())
  customerId      String
  categoryId      String
  targetProviderId String?
  title           String
  description     String
  photos          String[]
  addressId       String?
  city            String
  desiredDate     DateTime?
  desiredTime     String?
  approxBudget    Decimal?              @db.Decimal(10, 2)
  status          ServiceRequestStatus  @default(SOLICITADO)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  customer       CustomerProfile  @relation(fields: [customerId], references: [id])
  category       Category         @relation(fields: [categoryId], references: [id])
  targetProvider ProviderProfile? @relation("RequestsForProvider", fields: [targetProviderId], references: [id])
  address        Address?         @relation(fields: [addressId], references: [id])
  proposals      Proposal[]
  order          Order?
  messages       Message[]
  statusHistory  ServiceStatusEvent[]

  @@index([status])
  @@index([categoryId])
  @@map("service_requests")
}

model ServiceStatusEvent {
  id               String                @id @default(uuid())
  serviceRequestId String
  status           ServiceRequestStatus
  note             String?
  createdAt        DateTime              @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@map("service_status_events")
}

model Proposal {
  id               String         @id @default(uuid())
  serviceRequestId String
  providerId       String
  value            Decimal        @db.Decimal(10, 2)
  description      String
  estimatedDays    Int?
  availableDate    DateTime?
  notes            String?
  status           ProposalStatus @default(ENVIADA)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  serviceRequest ServiceRequest  @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  provider       ProviderProfile @relation(fields: [providerId], references: [id])
  order          Order?

  @@index([serviceRequestId])
  @@map("proposals")
}

// ─────────────────────────────────────────────────────────────────
// PEDIDOS / PAGAMENTOS / COMISSÕES
// ─────────────────────────────────────────────────────────────────

model Order {
  id               String   @id @default(uuid())
  serviceRequestId String   @unique
  proposalId       String   @unique
  customerId       String
  providerId       String
  grossAmount      Decimal  @db.Decimal(10, 2)
  commissionRate   Decimal  @db.Decimal(5, 2) // percentual imutável aplicado neste pedido
  commissionAmount Decimal  @db.Decimal(10, 2)
  providerAmount   Decimal  @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  serviceRequest ServiceRequest  @relation(fields: [serviceRequestId], references: [id])
  proposal       Proposal        @relation(fields: [proposalId], references: [id])
  customer       CustomerProfile @relation(fields: [customerId], references: [id])
  provider       ProviderProfile @relation(fields: [providerId], references: [id])
  payment        Payment?
  review         Review?

  @@map("orders")
}

model Payment {
  id                String         @id @default(uuid())
  orderId           String         @unique
  gateway           PaymentGateway
  method            PaymentMethod
  status            PaymentStatus  @default(PENDENTE)
  grossAmount       Decimal        @db.Decimal(10, 2)
  gatewayFeeAmount  Decimal?       @db.Decimal(10, 2)
  commissionAmount  Decimal        @db.Decimal(10, 2)
  providerNetAmount Decimal        @db.Decimal(10, 2)
  externalPaymentId String? // id retornado pelo gateway
  externalPreferenceId String?
  idempotencyKey    String         @unique
  approvedAt        DateTime?
  refundedAt         DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  order        Order                 @relation(fields: [orderId], references: [id])
  transactions PaymentTransaction[]
  commission   Commission?
  payout       Payout?

  @@index([status])
  @@map("payments")
}

// Log imutável de cada evento recebido do gateway (idempotência/auditoria de webhooks)
model PaymentTransaction {
  id              String   @id @default(uuid())
  paymentId       String
  eventType       String // payment.created, payment.approved, payment.refunded, chargeback...
  rawPayload      Json
  signatureValid  Boolean
  processedAt     DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("payment_transactions")
}

// Registro imutável da comissão aplicada a cada pagamento aprovado (auditoria)
model Commission {
  id         String   @id @default(uuid())
  paymentId  String   @unique
  rateApplied Decimal @db.Decimal(5, 2)
  amount      Decimal @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id])

  @@map("commissions")
}

model ProviderWallet {
  id               String   @id @default(uuid())
  providerId       String   @unique
  availableBalance Decimal  @default(0) @db.Decimal(12, 2)
  pendingBalance   Decimal  @default(0) @db.Decimal(12, 2)
  totalReceived    Decimal  @default(0) @db.Decimal(12, 2)
  totalCommission  Decimal  @default(0) @db.Decimal(12, 2)
  totalFees        Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt        DateTime @updatedAt

  provider ProviderProfile @relation(fields: [providerId], references: [id])
  payouts  Payout[]

  @@map("provider_wallets")
}

model Payout {
  id               String       @id @default(uuid())
  walletId         String
  paymentId        String?      @unique
  amount           Decimal      @db.Decimal(10, 2)
  status           PayoutStatus @default(PENDENTE)
  externalTransferId String?
  requestedAt      DateTime     @default(now())
  paidAt           DateTime?

  wallet  ProviderWallet @relation(fields: [walletId], references: [id])
  payment Payment?       @relation(fields: [paymentId], references: [id])

  @@map("payouts")
}

// ─────────────────────────────────────────────────────────────────
// AVALIAÇÕES / MENSAGENS / NOTIFICAÇÕES
// ─────────────────────────────────────────────────────────────────

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  customerId String
  providerId String
  rating     Int // 1 a 5
  comment    String?
  createdAt  DateTime @default(now())

  order    Order           @relation(fields: [orderId], references: [id])
  customer CustomerProfile @relation("ReviewsByCustomer", fields: [customerId], references: [id])
  provider ProviderProfile @relation("ReviewsForProvider", fields: [providerId], references: [id])

  @@map("reviews")
}

model Message {
  id               String    @id @default(uuid())
  serviceRequestId String
  senderId         String
  content          String
  readAt           DateTime?
  createdAt        DateTime  @default(now())

  serviceRequest ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)

  @@index([serviceRequestId])
  @@map("messages")
}

model Notification {
  id        String            @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────
// DISPUTAS / CONFIGURAÇÃO / AUDITORIA
// ─────────────────────────────────────────────────────────────────

model Dispute {
  id          String        @id @default(uuid())
  orderId     String
  openedById  String
  reason      String
  status      DisputeStatus @default(ABERTA)
  resolution  String?
  createdAt   DateTime      @default(now())
  resolvedAt  DateTime?

  @@map("disputes")
}

model PaymentOAuthState {
  id         String   @id @default(uuid())
  providerId String
  stateHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId])
  @@index([expiresAt])
  @@map("payment_oauth_states")
}

model PlatformSetting {
  id                String   @id @default(uuid())
  key               String   @unique
  value             Json
  updatedAt         DateTime @updatedAt

  @@map("platform_settings")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
